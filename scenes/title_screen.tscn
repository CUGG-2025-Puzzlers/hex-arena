[sub_resource type="Shader" id="Shader_fog"]
code = "shader_type canvas_item;

void fragment() {
	vec2 p = UV - vec2(0.5);
	p.x *= 0.72;
	float distance_from_center = length(p);
	float center_fog = 1.0 - smoothstep(0.10, 0.62, distance_from_center);
	float edge_vignette = smoothstep(0.35, 0.82, distance_from_center);
	vec3 fog_color = vec3(0.035, 0.15, 0.16);
	vec3 edge_color = vec3(0.015, 0.025, 0.04);
	vec3 color = mix(fog_color, edge_color, edge_vignette);
	float alpha = center_fog * 0.55 + edge_vignette * 0.72;
	COLOR = vec4(color, alpha);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fog"]
shader = SubResource("Shader_fog")

